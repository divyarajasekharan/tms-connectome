excel_dir="${OAK}/users/rdivya/tms/data/excel"
clinical_df="${excel_dir}/inputs/data-agg_may2025.csv"
schaefer_df="${excel_dir}/outputs/EField_99thPercentile_AvgCoil_Connected_FullSample_Schaefer400_WeightedStimMask_FC_20250731.xlsx"
tian_df="${excel_dir}/outputs/EField_99thPercentile_AvgCoil_Connected_FullSample_TianS2_WeightedStimMask_FC_20250731.xlsx"

ml python/3.9

python3.9 -u profile_stim_network.py ${schaefer_df} 