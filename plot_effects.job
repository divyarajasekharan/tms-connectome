#!/bin/bash
#
#SBATCH -J plot_effects
#SBATCH --time=2:00:00
#SBATCH -n 1
#SBATCH --cpus-per-task=1
#SBATCH --mem=8G
#SBATCH -p leanew1,normal  # Queue names you can submit to
# Outputs ----------------------------------
#SBATCH -o logs/plot_effects_%A.out
#SBATCH -e logs/plot_effects_%A.error
#SBATCH --mail-user=rdivya@stanford.edu
#SBATCH --mail-type=ALL
# ------------------------------------------
excel_dir="${OAK}/users/rdivya/tms/data/excel"
results_df="${excel_dir}/outputs/EField_99thPercentile_AvgCoil_Connected_FullSample_TxModel_20251106.xlsx"

results_df=$1
shift 1
args=$@

ml python/3.9

python3.9 -u plot_effects.py ${results_df} ${args} 